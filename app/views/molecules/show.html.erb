<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "molecules/modal", molecule: @molecule %>
<% else %>
  <% content_for :title, "#{@molecule.name} | Molecules / Compounds | Chemist" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@molecule) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Molecules / Compounds", molecules_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "Browse Atoms / Functional Groups →", functional_groups_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600"><%= @molecule.chemical_class.name %></p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900"><%= @molecule.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @molecule.description %></p>

      <% if @molecule.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Themes for <%= @molecule.name %>">
          <% @molecule.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "molecules/functional_groups_section", molecule: @molecule %>

    <%= render "shared/embedding_panel",
               record: @molecule,
               action_path: generate_embedding_molecule_path(@molecule),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
