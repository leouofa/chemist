<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "functional_groups/modal", functional_group: @functional_group %>
<% else %>
  <% content_for :title, "#{@functional_group.name} | Planets & Atoms / Functional Groups | Chemist" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@functional_group) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Atoms / Functional Groups", functional_groups_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "View Molecule (#{@functional_group.molecule.name}) →", molecule_path(@functional_group.molecule), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
          <%= @functional_group.molecule.chemical_class.name %>
        </span>
        <span class="text-xs text-slate-500">&bull;</span>
        <span class="text-xs font-medium text-slate-600"><%= @functional_group.molecule.name %></span>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= @functional_group.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @functional_group.description %></p>

      <% if @functional_group.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Thematic tags for <%= @functional_group.name %>">
          <% @functional_group.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "shared/embedding_panel",
               record: @functional_group,
               action_path: generate_embedding_functional_group_path(@functional_group),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
