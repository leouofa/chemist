<% content_for :title, "Planets & Atoms / Functional Groups | Chemist" %>

<%= turbo_stream_from PopulateFunctionalGroupsJob::GLOBAL_STREAM_NAME %>

<div class="w-full max-w-5xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Atoms / Functional Groups</h1>
      <p class="mt-2 text-sm text-slate-600">
        <%= @total_functional_groups_count %> atoms / functional groups cataloged across <%= @molecules_count %> molecules / compounds.
      </p>
    </div>

    <div class="shrink-0">
      <%= render "pages/populate_controls",
                 running: false,
                 action_path: populate_functional_groups_path,
                 button_label: "Discover Atoms / Functional Groups",
                 controls_target: "populate_all_functional_groups_controls",
                 status_message: notice,
                 status_kind: (notice.present? ? :info : nil) %>
    </div>
  </header>

  <%= render "pages/functional_groups_list",
             molecule_groups: @molecule_groups,
             total_functional_groups_count: @total_functional_groups_count,
             molecules_count: @molecules_count %>
</div>
